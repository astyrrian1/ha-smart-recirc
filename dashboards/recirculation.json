{
  "title": "Recirculation",
  "path": "recirculation",
  "icon": "mdi:pump",
  "type": "sections",
  "max_columns": 3,
  "sections": [
    {
      "type": "grid",
      "cards": [
        {
          "type": "heading",
          "heading": "Pump & controls",
          "heading_style": "title",
          "icon": "mdi:pump"
        },
        {
          "type": "tile",
          "entity": "binary_sensor.smartcirc_pump_running",
          "name": "Pump",
          "tap_action": {
            "action": "more-info"
          },
          "icon_tap_action": {
            "action": "more-info"
          },
          "grid_options": {
            "columns": 6,
            "rows": 1
          },
          "icon": "mdi:pump"
        },
        {
          "type": "tile",
          "entity": "binary_sensor.smartcirc_timer_active",
          "name": "Schedule active",
          "tap_action": {
            "action": "more-info"
          },
          "icon_tap_action": {
            "action": "more-info"
          },
          "grid_options": {
            "columns": 6,
            "rows": 1
          },
          "icon": "mdi:calendar-clock"
        },
        {
          "type": "grid",
          "columns": 2,
          "square": false,
          "grid_options": {
            "columns": 12
          },
          "cards": [
            {
              "type": "button",
              "entity": "button.smartcirc_trigger_pump",
              "name": "Start circulation",
              "icon": "mdi:play",
              "show_state": false,
              "tap_action": {
                "action": "perform-action",
                "perform_action": "button.press",
                "target": {
                  "entity_id": "button.smartcirc_trigger_pump"
                }
              },
              "hold_action": {
                "action": "more-info"
              }
            },
            {
              "type": "conditional",
              "conditions": [
                {
                  "condition": "state",
                  "entity": "binary_sensor.smartcirc_timer_active",
                  "state": "off"
                }
              ],
              "card": {
                "type": "button",
                "entity": "button.smartcirc_stop_pump",
                "name": "Stop pump",
                "icon": "mdi:stop",
                "show_state": false,
                "tap_action": {
                  "action": "perform-action",
                  "perform_action": "button.press",
                  "target": {
                    "entity_id": "button.smartcirc_stop_pump"
                  }
                },
                "hold_action": {
                  "action": "more-info"
                }
              }
            }
          ]
        },
        {
          "type": "conditional",
          "conditions": [
            {
              "condition": "state",
              "entity": "binary_sensor.smartcirc_timer_active",
              "state": "on"
            }
          ],
          "card": {
            "type": "markdown",
            "content": "A controller schedule is active. Manual stop is unavailable until it ends."
          }
        },
        {
          "type": "tile",
          "entity": "binary_sensor.smartcirc_run_time_exceeded",
          "name": "Runtime limit",
          "tap_action": {
            "action": "more-info"
          },
          "icon_tap_action": {
            "action": "more-info"
          },
          "grid_options": {
            "columns": 6,
            "rows": 1
          },
          "icon": "mdi:timer-alert-outline"
        },
        {
          "type": "tile",
          "entity": "binary_sensor.smartcirc_temperature_error",
          "name": "Temperature fault",
          "tap_action": {
            "action": "more-info"
          },
          "icon_tap_action": {
            "action": "more-info"
          },
          "grid_options": {
            "columns": 6,
            "rows": 1
          },
          "icon": "mdi:thermometer-alert"
        },
        {
          "type": "tile",
          "entity": "sensor.smartcirc_last_successful_read",
          "name": "Last received update",
          "tap_action": {
            "action": "more-info"
          },
          "icon_tap_action": {
            "action": "more-info"
          },
          "grid_options": {
            "columns": 12,
            "rows": 1
          },
          "icon": "mdi:update"
        },
        {
          "type": "history-graph",
          "title": "Pump activity \u00b7 24 hours",
          "hours_to_show": 24,
          "entities": [
            {
              "entity": "binary_sensor.smartcirc_pump_running",
              "name": "Pump"
            },
            {
              "entity": "binary_sensor.smartcirc_timer_active",
              "name": "Schedule"
            }
          ],
          "grid_options": {
            "columns": 12
          }
        }
      ]
    },
    {
      "type": "grid",
      "cards": [
        {
          "type": "heading",
          "heading": "Temperatures & flow",
          "heading_style": "title",
          "icon": "mdi:thermometer-water"
        },
        {
          "type": "tile",
