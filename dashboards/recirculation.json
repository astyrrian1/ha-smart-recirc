        {
          "type": "tile",
          "entity": "sensor.smartcirc_probe_2_raw_value",
          "name": "High temperature",
          "tap_action": {
            "action": "more-info"
          },
          "icon_tap_action": {
            "action": "more-info"
          },
          "grid_options": {
            "columns": 6,
            "rows": 1
          },
          "icon": "mdi:thermometer-high"
        },
        {
          "type": "tile",
          "entity": "sensor.smartcirc_temperature_difference",
          "name": "Temperature difference",
          "tap_action": {
            "action": "more-info"
          },
          "icon_tap_action": {
            "action": "more-info"
          },
          "grid_options": {
            "columns": 6,
            "rows": 1
          },
          "icon": "mdi:thermometer-lines"
        },
        {
          "type": "tile",
          "entity": "sensor.smartcirc_flow_pulse_count",
          "name": "Flow pulses",
          "tap_action": {
            "action": "more-info"
          },
          "icon_tap_action": {
            "action": "more-info"
          },
          "grid_options": {
            "columns": 6,
            "rows": 1
          },
          "icon": "mdi:water"
        },
        {
          "type": "history-graph",
          "title": "Temperatures \u00b7 24 hours",
          "hours_to_show": 24,
          "entities": [
            {
              "entity": "sensor.smartcirc_probe_1_raw_value",
              "name": "Low"
            },
            {
              "entity": "sensor.smartcirc_probe_2_raw_value",
              "name": "High"
            }
          ],
          "grid_options": {
            "columns": 12
          }
        },
        {
          "type": "tile",
          "entity": "sensor.recirculation_pump_electric_consumption_w",
          "name": "Pump power",
          "tap_action": {
            "action": "more-info"
          },
          "icon_tap_action": {
            "action": "more-info"
          },
          "grid_options": {
            "columns": 12,
            "rows": 1
          },
          "icon": "mdi:flash"
        },
        {
          "type": "statistics-graph",
          "title": "Pump power \u00b7 24 hours",
          "chart_type": "line",
          "period": "5minute",
          "days_to_show": 1,
          "stat_types": [
            "mean"
          ],
          "entities": [
            {
              "entity": "sensor.recirculation_pump_electric_consumption_w",
              "name": "Power"
            }
          ],
          "grid_options": {
            "columns": 12
          }
        }
      ]
    },
    {
      "type": "grid",
      "cards": [
        {
          "type": "heading",
          "heading": "Controller settings",
          "heading_style": "title",
          "icon": "mdi:tune"
        },
        {
          "type": "tile",
          "entity": "switch.smartcirc_controller_enabled",
          "name": "Controller enabled",
          "tap_action": {
            "action": "more-info"
          },
          "icon_tap_action": {
            "action": "more-info"
          },
          "grid_options": {
            "columns": 12,
            "rows": 2
          },
          "icon": "mdi:power",
          "features": [
            {
              "type": "toggle"
            }
          ]
        },
        {
          "type": "entities",
          "title": "Operating settings",
          "show_header_toggle": false,
          "entities": [
            {
              "entity": "switch.smartcirc_timers_enabled",
              "name": "Schedules enabled"
            },
            {
              "entity": "switch.smartcirc_smart_timers_enabled",
              "name": "Smart timers enabled"
            },
            {
              "entity": "switch.smartcirc_daylight_saving_time",
              "name": "Daylight saving time"
            },
            {
              "entity": "number.smartcirc_flow_sensitivity",
              "name": "Flow sensitivity"
            },
            {
              "entity": "number.smartcirc_dormant_interval",
              "name": "Dormant interval"
            },
            {
              "entity": "number.smartcirc_flow_detection_delay",
              "name": "Flow detection delay"
            },
            {
              "entity": "number.smartcirc_initial_run_time",
              "name": "Initial run time"
            },
            {
              "entity": "number.smartcirc_maximum_run_time",
              "name": "Maximum run time"
            }
          ],
          "grid_options": {
            "columns": 12
          }
        },
        {
          "type": "tile",
          "entity": "sensor.smartcirc_firmware",
          "name": "Firmware",
