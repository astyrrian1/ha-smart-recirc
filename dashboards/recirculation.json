            "action": "more-info"
          },
          "icon_tap_action": {
            "action": "more-info"
          },
          "grid_options": {
            "columns": 6,
            "rows": 1
          },
          "icon": "mdi:chip"
        },
        {
          "type": "button",
          "entity": "button.smartcirc_refresh_readings",
          "name": "Refresh readings",
          "icon": "mdi:refresh",
          "show_state": false,
          "tap_action": {
            "action": "perform-action",
            "perform_action": "button.press",
            "target": {
              "entity_id": "button.smartcirc_refresh_readings"
            }
          },
          "hold_action": {
            "action": "more-info"
          }
        }
      ]
    }
  ]
}
